# ─── BASE DE DATOS ───────────────────────────────────────────────
# Local Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sazon_uvitano"
# Neon (producción):
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── SERVIDOR ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=sazon-uvitano-secret-key-min-32-caracteres
JWT_REFRESH_SECRET=sazon-uvitano-refresh-key-min-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS (separar múltiples orígenes con coma) ──────────────────
# Local:
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Producción (reemplaza con tu URL de Vercel):
# CORS_ORIGIN=https://sazon-uvitano.vercel.app,https://sazon-uvitano-*.vercel.app

# ─── RATE LIMITING ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
